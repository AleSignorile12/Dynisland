<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Quick controls toggle Dark Mode through System Events.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>The Mixer changes the volume of individual apps.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>The Calendar section shows your upcoming events.</string>
	<key>NSLocationUsageDescription</key>
	<string>Weather beside the notch and on the Calendar page uses your approximate location.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Weather beside the notch and on the Calendar page uses your approximate location.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Live captions turn the audio your Mac plays into subtitles, on device.</string>
	<key>NSCameraUsageDescription</key>
	<string>The Mirror section shows a live camera preview.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Dynisland shows the progress of active downloads.</string>
</dict>
</plist>
